@model List<AlanCart.Models.OrderData>
@{
    ViewBag.Title = "OrderHistories";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@AlanCart.Resources.Lang.OrderHistories</h2>



<div class="row">
    @foreach(AlanCart.Models.OrderData od in Model)
    {
        <a href="@Url.Action("OrderHistoryDetail","Orders",new { strorderdataid = od.Id})">
            <div class="col-xs-12">
                <div class="panel panel-default">
                    <div class="panel">
                        <div>
                            @od.Id
                        </div>
                    </div>
                </div>
            </div>
        </a>
    }
</div>
