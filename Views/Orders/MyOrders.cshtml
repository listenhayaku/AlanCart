@model List<AlanCart.Models.OrderData>
@{
    ViewBag.Title = "MyOrders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@AlanCart.Resources.Lang.MyOrders</h2>

@foreach(AlanCart.Models.OrderData od in Model)
{
    <a href="@Url.Action("MyOrderDetail",new { strorderdataid = od.Id })">
        <div class="col-lg-10 col-md-10 col-sm-10 col-xs-10 panel panel-default">
            <div class="panel-body">
                <table class="table table-bordered">
                    <tr>
                        <td>
                            Id:@od.Id
                        </td>
                        <td>
                            @AlanCart.Resources.Lang.Seller:@od.UserData1.Nickname
                        </td>
                        <td>
                            @AlanCart.Resources.Lang.TotalAmount:@od.TotalAmount
                        </td>
                        <td>
                            @AlanCart.Resources.Lang.OrderStatus
                            @switch (od.OrderStatus)
                            {
                                case 0:
                                    @:havn't began
                                    break;
                                case 1:
                                    @:processing
                                    break;
                                case 2:
                                    @:done!
                                    break;
                                default:
                                    @:what?
                                    break;
                                }
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </a>
}