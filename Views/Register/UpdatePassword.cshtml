
@{
    ViewBag.Title = "UpdatePassword";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>UpdatePassword</h2>

@if (ViewBag.Message != null)
{
    <h5 class="alert-info">@ViewBag.Message</h5>
}

@using (Html.BeginForm("UpdatePassword", "Register", FormMethod.Post))
{
    @Html.Label("Password")
    @Html.TextBox("Password")
    @Html.Label("PasswordConfirm")
    @Html.TextBox("PasswordConfirm")

    <input type="submit" />
}
