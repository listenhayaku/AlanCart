@model List<AlanCart.Models.ProductData>
@{
    ViewBag.Title = "MyProducts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>MyProducts</h2>

@if(ViewBag.Message != null)
{
    <h5 class="alert-info">@ViewBag.Message</h5>
}

<div class="row">
    @foreach (AlanCart.Models.ProductData pd in Model)
    {
        using(Html.BeginForm("EditProduct", "Products", FormMethod.Post))
        {
            <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
                <div class="panel panel-default">
                    <div class="panel-body">
                        @Html.Hidden("Id", 123)
                        <img src="@Url.Content(pd.ImgUrl)" alt="Alternate Text" class="" />
                        <h5>Productname:@pd.Productname</h5>
                        <h5>Price:@pd.Price</h5>
                        <h5>Stock:@pd.Stock</h5>
                        <h5>Available:@pd.Available</h5>

                        @Html.TextBox("Productname", pd.Productname)
                        @Html.TextBox("Price", pd.Price)
                        @Html.TextBox("Stock", pd.Stock)
                        @Html.TextBox("Available", pd.Available)

                        <button class="btn btn-success">Save</button>
                        <a href="@Url.Action("DeleteProduct", new { strproductid = pd.Id })" class="btn btn-danger">Delete</a>
                        <button type="button" class="btn btn-primary">Edit/Cancel</button>
                    </div>
                </div>
            </div>
            }
        }
</div>