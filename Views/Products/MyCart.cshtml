@using AlanCart.ViewModel
@{
    ViewBag.Title = "MyCart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .button-area-off{
        display: none;
    }
    .toggle-off{
        display:none;
    }
</style>

<h2>MyCart</h2>
@if(ViewBag.Message != null)
{
    <h5 class="alert-info">@ViewBag.Message</h5>
}


<h3>haven't checkouted</h3>

<div class="row">

    @foreach (MyCartViewModel item in Model)
    {
        using (Html.BeginForm("EditCart", "Products", FormMethod.Post))
        {
            <div class="col-xs-12 col-sm-6 col-md-3">
                <div class="panel panel-default">
                    <div class="panel-body">
                        <h5>ItemId:@item.CartOfUserId</h5>
                        <img src="@Url.Content(item.ImgUrl)" class="img-responsive">
                        <h5>ProductName:@item.ProductName</h5>
                        <h5>Price:@item.Price</h5>
                        <div class="toggle-on">Stock: @item.Stock</div>
                        @Html.Hidden("Stock", item.Stock)

                        @Html.Hidden("CartOfUserId", item.CartOfUserId)
                        <div class="button-area">
                            <div class="button-area-off">
                                <button type="submit" class="btn btn-success">Save</button>
                                @Html.ActionLink("Delete", Url.Content("DeleteItem"), new { strcartofuserid = item.CartOfUserId }, new { @class = "btn btn-danger" })
                            </div>
                        <button type="button" class="btn btn-primary">Edit</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

</div>

<button class="btn btn-primary">checkout</button>

<hr />

<h3>have checkouted</h3>

<script>
    function toggle(panel) {
        var button_area = panel.querySelector(".button-area");
        var stock_input = panel.querySelector("#Stock");
        if (stock_input.type == "hidden") {
            var oristock = document.querySelector(".toggle-on");
            oristock.classList.remove("toggle-on");
            oristock.classList.add("toggle-off");
            var button_cluster = button_area.querySelector(".button-area-off");
            stock_input.type = "";
            button_cluster.classList.remove("button-area-off");
            button_cluster.classList.add("button-area-on");
            var editcancelbutton = button_area.querySelector(".btn-primary");
            editcancelbutton.classList.remove("btn-primary");
            editcancelbutton.classList.add("btn-default");
            editcancelbutton.textContent = "Cancel";
            
        }
        else {
            var oristock = document.querySelector(".toggle-off");
            oristock.classList.remove("toggle-off");
            oristock.classList.add("toggle-on");
            var button_cluster = button_area.querySelector(".button-area-on");
            stock_input.type = "hidden";
            button_cluster.classList.remove("button-area-on");
            button_cluster.classList.add("button-area-off");
            var editcancelbutton = button_area.querySelector(".btn-default");
            editcancelbutton.classList.remove("btn-default");
            editcancelbutton.classList.add("btn-primary");
            editcancelbutton.textContent = "Edit";
        }
    }

    var panels = document.querySelectorAll(".panel-body");
    for (var i = 0; i < panels.length; i++) {
        var editbutton = panels[i].querySelector(".button-area .btn-primary");
        (function (panel) {
            editbutton.onclick = () => {
                toggle(panel);
            };
        })(panels[i]);
    }


</script>