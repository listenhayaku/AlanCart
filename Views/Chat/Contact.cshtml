@model List<AlanCart.Models.UserData>
@{
    ViewBag.Title = "Contact";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@AlanCart.Resources.Lang.Contact</h2>

<div class="row">
    @foreach (AlanCart.Models.UserData userdata in Model)
    {
        <a href="@Url.Action("Chat","Chat",new {with=userdata.Id})">
            <div class="col-xs-12 col-sm-6 col-md-4 col-lg3">
                <div class="panel panel-default">
                    <div class="panel-body">
                        <h5>@userdata.Nickname</h5>
                    </div>
                </div>
            </div>
        </a>
    }

</div>




